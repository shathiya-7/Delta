{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vercel_path=/api/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/api/index.py?__vercel_path=/js/$1"
    }
  ]
}
